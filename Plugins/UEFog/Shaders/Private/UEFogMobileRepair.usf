// M8 opt-in repair. Protected LOAD/M7 entry points remain byte-unchanged.
#include "/Plugin/UEFog/Private/UEFogMobileLoad.usf"
Texture2D<float4> ReconRepairRayInput;

float4 IntegrateRepairFullRay(int2 Pixel,out float3 Direction,out float NativeZ,out uint Executed)
{
    NativeZ=NativeAt(ReconViewMin+Pixel);
    float Axis=AxisDepth(NativeZ);
    float2 UV=(float2(Pixel)+.5)/float2(ReconViewSize);
    float4 H=mul(float4(UV.x*2-1,(1-2*UV.y)/ReconProjectionSignY,1,1),ReconClipToTranslatedWorld);
    Direction=normalize(H.xyz/H.w-ReconCameraTranslated);
    float3 O=ReconCameraTranslated-ReconSphereTranslated;
    float B=dot(O,Direction);
    float Discriminant=B*B-(dot(O,O)-400.0*400.0);
    float Entry=0,LengthCm=0;
    if (Discriminant>0)
    {
        float Root=sqrt(Discriminant);
        Entry=max(0.0,-B-Root);
        float Exit=-B+Root;
        if (NativeZ>0) Exit=min(Exit,Axis/max(Direction.x,1e-6));
        LengthCm=max(0.0,Exit-Entry);
    }
    Executed=0;
    float Tau=0;
    if (LengthCm>0 && ReconSigma>0)
    {
        float DS=LengthCm/float(ReconLoadSteps);
        [loop] for (uint Step=0;Step<ReconLoadSteps;++Step)
        {
            float3 Pn=(O+Direction*(Entry+(float(Step)+.5)*DS))/400.0;
            float Rho=1;
            if (ReconLoadDensity==2)
            {
                float Radial=max(0.0,1.0-dot(Pn,Pn));
                Rho=Radial*Radial*(.65+.35*sin(13*Pn.x)*sin(17*Pn.y)*sin(11*Pn.z));
            }
            Tau+=ReconSigma*Rho*DS*.01;
#if OPT_DIAGNOSTIC
            // Actual loop-body work, not a predicate*requested-N tag.
            ++Executed;
#endif
        }
    }
    float T=exp(-Tau);
    float A=Tau<.001 ? Tau*(1-Tau*.5+Tau*Tau/6-Tau*Tau*Tau/24) : 1-T;
    float4 ST=float4(float3(.35,.60,.90)*A,T);
    return float4(RoundForHalfStorage(ST.x),RoundForHalfStorage(ST.y),RoundForHalfStorage(ST.z),RoundForHalfStorage(ST.w));
}

void FusedRepairPS(float4 Position:SV_POSITION,noperspective float2 UV:TEXCOORD0,out float4 Out:SV_Target0
#if OPT_DIAGNOSTIC
    ,out float4 ObservedST:SV_Target1,out float4 ObservedAux:SV_Target2,out float4 ObservedRay:SV_Target3
#endif
)
{
    int2 Pixel=int2(UV*float2(ReconSceneExtent));
    int Compatible,Fallback;
    float4 ST=ReconstructGuidedOpt(Pixel-ReconViewMin,Compatible,Fallback);
    float3 D=0;float Z=0;uint Executed=0;
    // The original precise FP32 sum<=float32(1e-6) decides Fallback.
    [branch] if (Fallback>=0)
        ST=IntegrateRepairFullRay(Pixel-ReconViewMin,D,Z,Executed);
    Out=float4(ST.rgb*View.PreExposure+ST.a*ReconCin.Load(int3(Pixel,0)).rgb,1);
#if OPT_DIAGNOSTIC
    ObservedST=ST;
    ObservedAux=float4(Compatible,Fallback,Fallback>=0?1:0,Executed);
    ObservedRay=float4(D,Z);
#endif
}

[numthreads(8,8,1)]
void ObserveRepairDenseCS(uint3 Id:SV_DispatchThreadID)
{
    if (all(Id.xy==0))
    {
        ReconSamples[0]=float4(ReconTagA,ReconTagB,ReconFrame,9);
        ReconSamples[1]=float4(View.PreExposure,ReconNearCm,ReconSigma,ReconLoadSteps);
        ReconSamples[2]=float4(ReconViewSize,ReconFogSize);
        ReconSamples[3]=float4(ReconProbeInput.Load(int3(0,0,0)),ReconProbeInput.Load(int3(1,0,0)),ReconProbeInput.Load(int3(2,0,0)),ReconProfile);
        ReconSamples[4]=float4(ReconLoadDensity,ReconLoadSteps,ReconProfile==12?1:0,5);
    }
    if (all(Id.xy<(uint2)ReconFogSize))
    {
        uint2 P=min(uint2(ReconViewSize)-1,((2u*Id.xy+1u)*uint2(ReconViewSize))/(2u*uint2(ReconFogSize)));
        uint Row=5+2*(Id.x+Id.y*ReconFogSize.x);
        ReconSamples[Row]=ReconLowInput.Load(int3(Id.xy,0));
        ReconSamples[Row+1]=float4(NativeAt(ReconViewMin+int2(P)),ReconGuideInput.Load(int3(Id.xy,0)),P+uint2(ReconViewMin));
    }
    if (any(Id.xy>=(uint2)ReconViewSize)) return;
    uint Index=Id.x+Id.y*ReconViewSize.x;
    uint Stride=ReconProfile==12?6:4;
    uint Row=5+2*ReconFogSize.x*ReconFogSize.y+Stride*Index;
    int2 Pixel=ReconViewMin+int2(Id.xy);
    float Z=NativeAt(Pixel);
    float4 Aux=(ReconProfile==8||ReconProfile==12)?ReconOptAuxInput.Load(int3(Id.xy,0)):float4(ReconAuxInput[Index],0,0);
    ReconSamples[Row]=float4(Z,AxisDepth(Z),Aux.xy);
    ReconSamples[Row+1]=ReconInput.Load(int3(Id.xy,0));
    ReconSamples[Row+2]=ReconCin.Load(int3(Pixel,0));
    ReconSamples[Row+3]=ReconConsumed.Load(int3(Pixel,0));
    if (ReconProfile==12)
    {
        float4 Ray=ReconRepairRayInput.Load(int3(Id.xy,0));
        ReconSamples[Row+4]=float4(Aux.zw,Ray.w,0);
        ReconSamples[Row+5]=float4(Ray.xyz,0);
    }
}
